              "PREFEITURA",
              "OUTRO"
            ]
          },
          "descricao": {
            "type": "string",
            "nullable": true,
            "maxLength": 4000
          },
          "contatoEmail": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "contatoTelefone": {
            "type": "string",
            "nullable": true,
            "maxLength": 30
          },
          "id": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "papel": {
            "type": "string"
          }
        }
      },
      "Local": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "categoria": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "endereco": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "cidade": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "uf": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "cep": {
            "type": "string",
            "nullable": true,
            "maxLength": 9
          },
          "descricao": {
            "type": "string",
            "nullable": true,
            "maxLength": 4000
          },
          "acessibilidade": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          },
          "id": {
            "type": "integer"
          },
          "organizacaoId": {
