{
  "expo": {
    "name": "RolêOut",
    "slug": "roleout-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "br.com.roleout.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#06122F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06122F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": false,
          "locationWhenInUsePermission": "O RolêOut usa sua localização quando você solicita rolês próximos ou a posição de um local que está cadastrando.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "scheme": "roleout",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94098a22-1063-4f2e-9dda-5515a59324d4"
      }
    },
    "owner": "toledosantiago0"
  }
}
