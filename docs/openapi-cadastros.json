  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token opaco retornado no login, validade de 24 horas."
      }
    },
    "schemas": {
      "Cadastro": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nome",
          "email",
          "senha"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "senha": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        }
      },
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "senha"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "senha": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        }
      },
      "Conta": {
        "type": "object",
        "required": [
          "id",
          "nome",
          "email",
          "emailConfirmado",
          "administrador"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "emailConfirmado": {
            "type": "boolean"
          },
          "administrador": {
            "type": "boolean"
          }
        }
      },
      "Sessao": {
        "type": "object",
        "required": [
          "token",
          "expiraEm",
          "conta"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "expiraEm": {
            "type": "string",
            "format": "date-time"
          },
          "conta": {
            "$ref": "#/components/schemas/Conta"
          }
        }
      },
      "OrganizacaoEntrada": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nome",
          "tipo",
          "contatoEmail"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "tipo": {
            "type": "string",
            "enum": [
              "RESTAURANTE",
              "BAR",
              "MUSEU",
              "PREFEITURA",
              "OUTRO"
            ]
          },
          "descricao": {
            "type": "string",
            "nullable": true,
            "maxLength": 4000
          },
          "contatoEmail": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "contatoTelefone": {
            "type": "string",
            "nullable": true,
            "maxLength": 30
          }
        }
      },
      "LocalEntrada": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nome",
          "categoria",
          "endereco",
          "cidade",
          "uf"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "categoria": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "endereco": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "cidade": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "uf": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "cep": {
            "type": "string",
            "nullable": true,
            "maxLength": 9
          },
          "descricao": {
            "type": "string",
            "nullable": true,
            "maxLength": 4000
          },
          "acessibilidade": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          }
        }
      },
      "Erro": {
        "type": "object",
        "required": [
          "codigo",
          "mensagem"
        ],
        "properties": {
          "codigo": {
            "type": "string"
          },
          "mensagem": {
            "type": "string"
          }
        }
      },
      "Organizacao": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "tipo": {
            "type": "string",
            "enum": [
              "RESTAURANTE",
              "BAR",
